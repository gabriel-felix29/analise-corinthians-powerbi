table Partidas
	lineageTag: 63f27609-c7f1-4337-9608-d53d91bb874a

	/// Quantidade de partidas com resultado no contexto dos filtros.
	measure Jogos = CALCULATE(COUNTROWS(Partidas), Partidas[status] = "Com resultado")
		formatString: 0
		displayFolder: AC1
		lineageTag: 18b33d2c-2420-4348-a943-391bb265d281

	/// Partidas com resultado Vitória.
	measure Vitórias = CALCULATE([Jogos], Partidas[resultado] = "Vitória")
		formatString: 0
		displayFolder: AC1
		lineageTag: 026b3124-50f4-400b-98cb-2c7c3736b3e8

	/// Partidas com resultado Empate.
	measure Empates = CALCULATE([Jogos], Partidas[resultado] = "Empate")
		formatString: 0
		displayFolder: AC1
		lineageTag: 304791a7-54f8-45e1-8f7b-4a79a5ff8a17

	/// Partidas com resultado Derrota.
	measure Derrotas = CALCULATE([Jogos], Partidas[resultado] = "Derrota")
		formatString: 0
		displayFolder: AC1
		lineageTag: e01de356-34b9-4de0-969c-184f100fa6ef

	/// Gols marcados pelo Corinthians em partidas com resultado.
	measure 'Gols Pró' = CALCULATE(SUM(Partidas[gols_pro]), Partidas[status] = "Com resultado")
		formatString: 0
		displayFolder: AC1
		lineageTag: 5eea4cec-94eb-46d6-94bd-de84227f434d

	/// Gols sofridos pelo Corinthians em partidas com resultado.
	measure 'Gols Contra' = CALCULATE(SUM(Partidas[gols_contra]), Partidas[status] = "Com resultado")
		formatString: 0
		displayFolder: AC1
		lineageTag: 0c535b2e-011d-4820-a80e-62d1f4dd857e

	/// Diferença entre gols marcados e sofridos.
	measure 'Saldo de Gols' = [Gols Pró] - [Gols Contra]
		formatString: 0
		displayFolder: AC1
		lineageTag: 0489a295-e917-404e-87c8-da4047324106

	/// Proporção de jogos vencidos; não representa aproveitamento de pontos.
	measure 'Taxa de Vitórias' = DIVIDE([Vitórias], [Jogos])
		formatString: 0.0%
		displayFolder: AC1
		lineageTag: aaf66f3c-bb59-41e9-9962-fb103e0650aa

	/// Primeira linha da leitura dinamica dos resultados.
	measure 'Leitura - frequência' =
			VAR J = [Jogos]
			VAR V = COALESCE([Vitórias], 0)
			VAR E = COALESCE([Empates], 0)
			VAR D = COALESCE([Derrotas], 0)
			VAR Maior = MAX(V, MAX(E, D))
			VAR Sufixo = IF(Maior = 1, " partida", " partidas")
			VAR Lideres = IF(V = Maior, 1, 0) + IF(E = Maior, 1, 0) + IF(D = Maior, 1, 0)
			VAR Geral = J = 35 && V = 12 && E = 12 && D = 11
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(J) || J = 0, "Não há partidas com resultado para o recorte selecionado.",
					Geral, "Vitórias e empates tiveram a mesma frequência: 12 partidas cada, enquanto as derrotas somaram 11.",
					Lideres = 3, "Vitórias, empates e derrotas tiveram a mesma frequência: " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior && E = Maior, "Vitórias e empates foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior && D = Maior, "Vitórias e derrotas foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					E = Maior && D = Maior, "Empates e derrotas foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior, "Vitórias foram o resultado mais frequente, com " & FORMAT(V, "0") & Sufixo & ".",
					E = Maior, "Empates foram o resultado mais frequente, com " & FORMAT(E, "0") & Sufixo & ".",
					"Derrotas foram o resultado mais frequente, com " & FORMAT(D, "0") & Sufixo & "."
				)
		displayFolder: AC1
		lineageTag: c31b8a4d-ceca-4beb-89d7-3d35e13abd0b

	/// Segunda linha da leitura dinamica dos resultados.
	measure 'Leitura - distribuição' =
			VAR J = [Jogos]
			VAR V = COALESCE([Vitórias], 0)
			VAR E = COALESCE([Empates], 0)
			VAR D = COALESCE([Derrotas], 0)
			VAR TextoV = FORMAT(V, "0") & IF(V = 1, " vitória", " vitórias")
			VAR TextoE = FORMAT(E, "0") & IF(E = 1, " empate", " empates")
			VAR TextoD = FORMAT(D, "0") & IF(D = 1, " derrota", " derrotas")
			RETURN
				IF(
					ISBLANK(J) || J = 0,
					BLANK(),
					IF(
						J = 35 && V = 12 && E = 12 && D = 11,
						"A diferença de apenas um jogo entre os três resultados mostra uma distribuição equilibrada.",
						"Distribuição no recorte: " & TextoV & ", " & TextoE & " e " & TextoD & "."
					)
				)
		displayFolder: AC1
		lineageTag: 74dfb4ae-43b4-44bd-898b-568de09c3fc2

	/// Terceira linha da leitura dinamica, dedicada aos gols.
	measure 'Leitura - gols' =
			VAR J = [Jogos]
			VAR GP = COALESCE([Gols Pró], 0)
			VAR GC = COALESCE([Gols Contra], 0)
			VAR Saldo = COALESCE([Saldo de Gols], 0)
			VAR Inicio =
				SWITCH(
					TRUE(),
					Saldo > 0, "Nos gols, o Corinthians apresentou saldo positivo de " & FORMAT(Saldo, "+0;-0;0"),
					Saldo < 0, "Nos gols, o Corinthians apresentou saldo negativo de " & FORMAT(Saldo, "+0;-0;0"),
					"Nos gols, o Corinthians apresentou saldo zero"
				)
			RETURN
				IF(
					ISBLANK(J) || J = 0,
					BLANK(),
					Inicio & ", com " & FORMAT(GP, "0") & IF(GP = 1, " marcado", " marcados") & " e " & FORMAT(GC, "0") & IF(GC = 1, " sofrido", " sofridos") & "."
				)
		displayFolder: AC1
		lineageTag: 2054dd73-90d1-4493-935d-1e5ba3b24676

	/// Conclusão dinâmica da AC1 para resultados e gols.
	measure 'Conclusao AC1' =
			VAR J = [Jogos]
			VAR V = COALESCE([Vitórias], 0)
			VAR E = COALESCE([Empates], 0)
			VAR D = COALESCE([Derrotas], 0)
			VAR GP = COALESCE([Gols Pró], 0)
			VAR GC = COALESCE([Gols Contra], 0)
			VAR Saldo = COALESCE([Saldo de Gols], 0)
			VAR Maior = MAX(V, MAX(E, D))
			VAR Lideres = IF(V = Maior, 1, 0) + IF(E = Maior, 1, 0) + IF(D = Maior, 1, 0)
			VAR Sufixo = IF(Maior = 1, " partida", " partidas")
			VAR Geral = J = 35 && V = 12 && E = 12 && D = 11 && GP = 37 && GC = 32
			VAR TextoResultados =
				SWITCH(
					TRUE(),
					Geral, "Vitórias e empates tiveram a mesma frequência: 12 partidas cada, enquanto as derrotas somaram 11.",
					Lideres = 3, "Vitórias, empates e derrotas tiveram a mesma frequência: " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior && E = Maior, "Vitórias e empates foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior && D = Maior, "Vitórias e derrotas foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					E = Maior && D = Maior, "Empates e derrotas foram os resultados mais frequentes, com " & FORMAT(Maior, "0") & Sufixo & " cada.",
					V = Maior, "Vitórias foram o resultado mais frequente, com " & FORMAT(V, "0") & Sufixo & ".",
					E = Maior, "Empates foram o resultado mais frequente, com " & FORMAT(E, "0") & Sufixo & ".",
					"Derrotas foram o resultado mais frequente, com " & FORMAT(D, "0") & Sufixo & "."
				)
			VAR TextoGols =
				SWITCH(
					TRUE(),
					Saldo > 0, "Nos gols, o Corinthians apresentou saldo positivo de " & FORMAT(Saldo, "+0;-0;0"),
					Saldo < 0, "Nos gols, o Corinthians apresentou saldo negativo de " & FORMAT(Saldo, "+0;-0;0"),
					"Nos gols, o Corinthians apresentou saldo zero"
				)
				& ", com " & FORMAT(GP, "0") & IF(GP = 1, " marcado", " marcados")
				& " e " & FORMAT(GC, "0") & IF(GC = 1, " sofrido", " sofridos") & "."
			RETURN
				IF(
					ISBLANK(J) || J = 0,
					"Não há partidas com resultado para o recorte selecionado.",
					TextoResultados & UNICHAR(10) & TextoGols
				)
		displayFolder: AC1
		lineageTag: 5653d532-c414-4758-ba01-c082476878b0

