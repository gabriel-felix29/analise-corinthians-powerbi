/// AC1 — panorama dos resultados do Corinthians. Snapshot com 48 partidas; desempenho restrito às 35 com resultado entre 28/01 e 09/09/2026.
model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Partidas"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Partidas

ref cultureInfo pt-BR

